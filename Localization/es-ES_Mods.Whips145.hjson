Items: {
	Cobwhip: {
		DisplayName: Cobwhip
		Tooltip:
			'''
			3 de daño de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos para invocar una pequeña araña
			'''
	}

	Constellation: {
		DisplayName: Constellation
		Tooltip:
			'''
			15 de daño de invocación por marca
			15% de probabilidad de ataque crítico de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos para esparcir estrellas aliadas
			'''
	}

	ElectricEel: {
		DisplayName: Anguila Eléctrica
		Tooltip:
			'''
			12 de daño de invocación por marca
			5% de probabilidad de ataque crítico de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos con energía eléctrica
			La energía eléctrica resuena entre los enemigos
			'''
	}

	Possession: {
		DisplayName: Possession
		Tooltip:
			'''
			25 de daño de invocación por marca
			10% de probabilidad de ataque crítico de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos con energía profética
			Visiones atacan a los enemigos golpeados por invocaciones
			'''
	}

	SlimeWhip: {
		DisplayName: Látigo de Slime
		Tooltip:
			'''
			3 de daño de invocación por marca
			El chasquido del látigo puede encender a los enemigos
			'''
	}

	Soulscourge: {
		DisplayName: Soulscourge
		Tooltip:
			'''
			5 de daño de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			'Azota a tus enemigos con los restos del mal encarnado'
			'''
	}

	Starcrash: {
		DisplayName: Starcrash
		Tooltip:
			'''
			2 de daño de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos con energía inestable
			Meteoritos caen sobre los enemigos inestables al ser golpeados por invocaciones
			'''
	}

	Vasculash: {
		DisplayName: Vasculash
		Tooltip:
			'''
			5 de daño de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			'¡Arterias, venas y tendones!'
			'''
	}

	VulgarDisplayOfFlower: {
		DisplayName: Vulgar Display Of Flower
		Tooltip:
			'''
			9 de daño de invocación por marca
			Tus invocaciones se enfocarán en los enemigos golpeados
			Golpea a los enemigos con energía volátil
			Pétalos violentos florecen en los enemigos golpeados por invocaciones
			'¿Un látigo de espinas arrancado de la mismísima Reina de la Selva? ¡Brutal!'
			'''
	}
}

