Items: {
	Cobwhip: {
		DisplayName: Паутинный хлыст
		Tooltip:
			'''
			3 ед. урона от метки для призывателей
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов, чтобы призвать крошечного паука
			'''
	}

	Constellation: {
		DisplayName: Созвездие
		Tooltip:
			'''
			15 ед. урона от метки для призывателей
			15% шанс критического удара от метки
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов, чтобы рассыпать дружественные звезды
			'''
	}

	ElectricEel: {
		DisplayName: Электрический угорь
		Tooltip:
			'''
			12 ед. урона от метки для призывателей
			5% шанс критического удара от метки
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов электрической энергией
			Электрическая энергия резонирует между врагами
			'''
	}

	Possession: {
		DisplayName: Одержимость
		Tooltip:
			'''
			25 ед. урона от метки для призывателей
			10% шанс критического удара от метки
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов пророческой энергией
			Видения поражают врагов, получивших урон от миньонов
			'''
	}

	SlimeWhip: {
		DisplayName: Слизневый хлыст
		Tooltip:
			'''
			3 ед. урона от метки для призывателей
			Удар хлыстом может поджечь врагов
			'''
	}

	Soulscourge: {
		DisplayName: Бич душ
		Tooltip:
			'''
			5 ед. урона от метки для призывателей
			Ваши миньоны сфокусируют атаки на пораженных врагах
			'Стегайте врагов остатками воплощенного зла'
			'''
	}

	Starcrash: {
		DisplayName: Звездопад
		Tooltip:
			'''
			2 ед. урона от метки для призывателей
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов заряженной энергией
			Метеориты падают на заряженных врагов, получивших урон от миньонов
			'''
	}

	Vasculash: {
		DisplayName: Кровеносный хлыст
		Tooltip:
			'''
			5 ед. урона от метки для призывателей
			Ваши миньоны сфокусируют атаки на пораженных врагах
			'Артерии, вены и сухожилия!'
			'''
	}

	VulgarDisplayOfFlower: {
		DisplayName: Вульгарное проявление цветка
		Tooltip:
			'''
			9 ед. урона от метки для призывателей
			Ваши миньоны сфокусируют атаки на пораженных врагах
			Поразите врагов нестабильной энергией
			Яростные лепестки распускаются из врагов, пораженных миньонами
			'Шипастый хлыст, вырванный из самой Королевы джунглей? Металл!'
			'''
	}
}

