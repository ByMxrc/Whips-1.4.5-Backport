Configs: {
	WhipsBackportConfig: {
		DisplayName: Конфигурация переноса хлыстов

		Headers: {
			VanillaAssetBackport: Заголовок переноса оригинальных ресурсов
			Info: Заголовок информации
		}

		Terraria145Path: {
			Label: Путь к Terraria 1.4.5
			Tooltip:
				'''
				Необязательно: путь к корневой папке вашей установки Terraria 1.4.5
				(папка, содержащая подпапку 'Content').
				Пример: C:\Program Files (x86)\Steam\steamapps\common\Terraria

				Если настроено, хлысты будут использовать официальные спрайты из 1.4.5,
				считывая их локально. Мод НЕ распространяет никакие игровые ресурсы.
				'''
		}

		ShowInfo: {
			Label: Примечание
			Tooltip:
				'''
				Этот мод загружает спрайты хлыстов непосредственно из
				вашей локальной установки Terraria — он не распространяет никакие ресурсы.

				Обнаружение происходит автоматически. Вам ничего не нужно настраивать.
				'''
		}
	}
}
