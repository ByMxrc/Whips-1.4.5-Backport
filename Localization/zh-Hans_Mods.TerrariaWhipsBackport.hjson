Items: {
	Cobwhip: {
		DisplayName: 蛛丝鞭
		Tooltip:
			'''
			3 召唤标记伤害
			你的召唤物将集中攻击被击中的敌人
			击中敌人以召唤一只小蜘蛛
			'''
	}

	Constellation: {
		DisplayName: 星座
		Tooltip:
			'''
			15 召唤标记伤害
			15% 召唤标记暴击率
			你的召唤物将集中攻击被击中的敌人
			击中敌人以散落友方星星
			'''
	}

	ElectricEel: {
		DisplayName: 电鳗
		Tooltip:
			'''
			12 召唤标记伤害
			5% 召唤标记暴击率
			你的召唤物将集中攻击被击中的敌人
			用电能打击敌人
			电能在敌人之间共鸣
			'''
	}

	Possession: {
		DisplayName: 占有
		Tooltip:
			'''
			25 召唤标记伤害
			10% 召唤标记暴击率
			你的召唤物将集中攻击被击中的敌人
			用预言能量打击敌人
			幻象会打击被召唤物击中的敌人
			'''
	}

	SlimeWhip: {
		DisplayName: 史莱姆鞭
		Tooltip:
			'''
			3 召唤标记伤害
			鞭打可以点燃敌人
			'''
	}

	Soulscourge: {
		DisplayName: 灵魂鞭挞
		Tooltip:
			'''
			5 召唤标记伤害
			你的召唤物将集中攻击被击中的敌人
			'用邪恶化身的残骸鞭打你的敌人'
			'''
	}

	Starcrash: {
		DisplayName: 星际坠落
		Tooltip:
			'''
			2 召唤标记伤害
			你的召唤物将集中攻击被击中的敌人
			用充沛能量打击敌人
			陨石落在被召唤物击中的充能敌人身上
			'''
	}

	Vasculash: {
		DisplayName: 血管鞭
		Tooltip:
			'''
			5 召唤标记伤害
			你的召唤物将集中攻击被击中的敌人
			'动脉、静脉和肌腱！'
			'''
	}

	VulgarDisplayOfFlower: {
		DisplayName: 粗俗的花之展示
		Tooltip:
			'''
			9 召唤标记伤害
			你的召唤物将集中攻击被击中的敌人
			用不稳定能量打击敌人
			狂暴的花瓣从被召唤物击中的敌人身上绽放
			'一条从丛林女王身上扯下的带刺长鞭？太硬核了！'
			'''
	}
}

