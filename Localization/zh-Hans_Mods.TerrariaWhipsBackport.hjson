Configs: {
	WhipsBackportConfig: {
		DisplayName: 鞭子反向移植配置

		Headers: {
			VanillaAssetBackport: 原版资产反向移植标题
			Info: 信息标题
		}

		Terraria145Path: {
			Label: 泰拉瑞亚 1.4.5 路径
			Tooltip:
				'''
				可选：你的泰拉瑞亚 1.4.5 安装的根文件夹路径
				（包含 'Content' 子文件夹的文件夹）。
				例如：C:\Program Files (x86)\Steam\steamapps\common\Terraria

				如果已配置，鞭子将通过本地读取
				使用 1.4.5 的官方精灵图。该模组不重新分发任何游戏资产。
				'''
		}

		ShowInfo: {
			Label: 注意
			Tooltip:
				'''
				该模组直接从你的本地泰拉瑞亚安装加载鞭子的精灵图
				——不重新分发任何资产。

				检测是自动的。你无需配置任何内容。
				'''
		}
	}
}
