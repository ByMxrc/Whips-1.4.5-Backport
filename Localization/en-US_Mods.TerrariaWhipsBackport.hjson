Items: {
	Cobwhip: {
		DisplayName: Cobwhip
		Tooltip:
			'''
			3 summon tag damage
			Your summons will focus struck enemies
			Strike enemies to summon a tiny spider
			'''
	}

	Constellation: {
		DisplayName: Constellation
		Tooltip:
			'''
			15 summon tag damage
			15% summon tag critical strike chance
			Your summons will focus struck enemies
			Strike enemies to scatter friendly stars
			'''
	}

	ElectricEel: {
		DisplayName: Electric Eel
		Tooltip:
			'''
			12 summon tag damage
			5% summon tag critical strike chance
			Your summons will focus struck enemies
			Strike enemies with electric energy
			Electric energy resonates between enemies
			'''
	}

	Possession: {
		DisplayName: Possession
		Tooltip:
			'''
			25 summon tag damage
			10% summon tag critical strike chance
			Your summons will focus struck enemies
			Strike enemies with prophetic energy
			Visions strike enemies hit by summons
			'''
	}

	SlimeWhip: {
		DisplayName: Slime Whip
		Tooltip:
			'''
			3 summon tag damage
			Whip crack can ignite enemies
			'''
	}

	Soulscourge: {
		DisplayName: Soulscourge
		Tooltip:
			'''
			5 summon tag damage
			Your summons will focus struck enemies
			'Lash your enemies with the remnants of evil incarnate'
			'''
	}

	Starcrash: {
		DisplayName: Starcrash
		Tooltip:
			'''
			2 summon tag damage
			Your summons will focus struck enemies
			Strike enemies with primed energy
			Meteorites fall on primed enemies hit by summons
			'''
	}

	Vasculash: {
		DisplayName: Vasculash
		Tooltip:
			'''
			5 summon tag damage
			Your summons will focus struck enemies
			'Arteries, veins, and sinew!'
			'''
	}

	VulgarDisplayOfFlower: {
		DisplayName: Vulgar Display Of Flower
		Tooltip:
			'''
			9 summon tag damage
			Your summons will focus struck enemies
			Strike enemies with volatile energy
			Violent petals bloom from enemies hit by summons
			'A thorn-barbed whip ripped from the Queen of the Jungle herself? Metal!'
			'''
	}
}

